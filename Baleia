<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chris Cell — Catálogo</title>
<style>
:root{--neon:#00f0b5;--neon2:#39ff14;--ink:#020b12;--panel:#07151d;--border:#1d333b}
*{box-sizing:border-box}
body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial;background:radial-gradient(circle at 50% 0%,#062a2a,#020a10 60%);color:#f5f7fa;min-height:100vh}
header{background:linear-gradient(135deg,#02080e,#04151e 48%,#063d3b);border-bottom:1px solid rgba(0,240,181,.18);padding:16px;box-shadow:0 8px 30px #0007;position:sticky;top:0;z-index:5}
.top{max-width:1180px;margin:auto;display:flex;align-items:center;justify-content:space-between;gap:12px}
.brandVisual{display:flex;align-items:center;gap:10px}
.brand{font-size:26px;line-height:.85;letter-spacing:1.2px;font-weight:950}
.brand b{color:var(--neon);font-style:italic}
.brand span{color:#fff}
.headerApple{width:34px;height:34px;color:#fff}
.headerAndroid{width:38px;height:38px;color:#3DDC84}
.sub{margin-left:44px;color:#b9d0d7;font-size:11px;letter-spacing:.4px}
button{border:0;border-radius:12px;padding:11px 15px;font-weight:800;cursor:pointer;font-family:inherit}
.adminBtn{background:linear-gradient(135deg,#eafff9,#bffff0);color:#05251f;border:1px solid rgba(0,240,181,.35);font-size:12px}
main{max-width:1220px;margin:auto;padding:20px 16px 60px}
.hero{background:linear-gradient(145deg,#05121a,#041c1e);border:1px solid rgba(0,240,181,.18);border-radius:24px;padding:20px;box-shadow:0 20px 55px #0005;margin-bottom:18px}
.hero h1{margin:0 0 8px;font-size:26px;color:#fff}
.heroPhrase{margin-top:8px;font-weight:800;color:#4ff2d0;font-size:15px}
.hero p{margin:0;color:#aab9c0;font-size:14px}
.timer{display:flex;align-items:center;gap:10px;background:#06141d;color:#b8fff0;border:1px solid #20d9ba;border-radius:13px;padding:11px 14px;font-size:12px;font-weight:900;box-shadow:0 0 20px rgba(20,184,166,.15);margin-top:14px;width:fit-content}
.timer strong{color:#fff;font-size:16px;font-variant-numeric:tabular-nums}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px;margin-top:10px}
.card{background:linear-gradient(160deg,#08151d,#071117);border:1px solid var(--border);border-radius:20px;overflow:hidden;box-shadow:0 15px 40px #0005;display:flex;flex-direction:column}
.photo{height:300px;background:radial-gradient(circle at 50% 30%,#172d35,#061016);position:relative;overflow:hidden;border-bottom:1px solid var(--border)}
.photoTrack{display:flex;width:100%;height:100%;overflow-x:auto;scroll-snap-type:x mandatory;scroll-behavior:smooth;scrollbar-width:none}
.photoTrack::-webkit-scrollbar{display:none}
.photoSlide{min-width:100%;height:100%;flex:0 0 100%;scroll-snap-align:center;display:flex;align-items:center;justify-content:center}
.photoSlide img{width:100%;height:100%;object-fit:contain;display:block;cursor:zoom-in}
.photoNav{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);display:flex;justify-content:space-between;padding:0 8px;pointer-events:none}
.photoNav button{width:34px;height:34px;border-radius:50%;background:#0009;color:#fff;font-size:20px;padding:0;pointer-events:auto;line-height:1}
.photoCountBadge{position:absolute;top:9px;right:9px;background:#000b;color:#fff;border-radius:20px;padding:5px 9px;font-size:11px;font-weight:800}
.placeholder{font-size:52px;opacity:.25;color:#fff}
.body{padding:15px;display:flex;flex-direction:column;gap:6px;flex:1}
.tag{display:inline-flex;align-items:center;font-size:10px;font-weight:900;padding:5px 9px;border-radius:20px;gap:4px;width:fit-content}
.tag.apple{background:#1a2025;color:#fff}
.tag.android{background:#102d1d;color:#a8ffb8}
.card h3{margin:6px 0 4px;font-size:18px;color:#fff}
.meta{color:#aab9c0;font-size:12px;line-height:1.55}
.price{font-size:22px;font-weight:900;color:#fff;margin:10px 0}
.available{color:#39ff88;font-weight:800;font-size:11px}
.sold{color:#ff6b6b;font-weight:800;font-size:11px}
.interest{width:100%;background:linear-gradient(135deg,#00ef9f,#0ccf7b);color:#00150f;margin-top:10px;border-radius:13px;padding:12px;font-size:14px;font-weight:900;box-shadow:0 8px 24px rgba(0,239,159,.2)}
.empty{text-align:center;color:#9fb1b8;padding:50px;font-size:15px}
.expired{text-align:center;padding:60px 20px;background:linear-gradient(145deg,#1a0606,#0a0202);border:1px solid #ff6b6b33;border-radius:24px;margin:30px auto;max-width:600px}
.expired h2{color:#ff6b6b;font-size:26px;margin:0 0 12px}
.expired p{color:#d0a0a0;margin:0 0 20px}
.expired a{display:inline-block;background:linear-gradient(135deg,#00ef9f,#0ccf7b);color:#00150f;padding:14px 24px;border-radius:13px;text-decoration:none;font-weight:900}
.overlay{display:none;position:fixed;inset:0;background:#000c;z-index:20;padding:18px;overflow:auto}
.overlay.on{display:block}
.panel{background:linear-gradient(160deg,#08151d,#071117);border:1px solid var(--border);max-width:760px;margin:25px auto;border-radius:20px;padding:22px;color:#fff}
.panelHead{display:flex;justify-content:space-between;align-items:center;margin-bottom:16px}
.panelHead h2{margin:0;font-size:22px;color:#4ff2d0}
.close{background:#1d333b;color:#fff}
.tabs{display:flex;gap:8px;margin:14px 0}
.tabs button{background:#1d333b;color:#aab9c0;font-size:13px}
.tabs .on{background:linear-gradient(135deg,#00ef9f,#0ccf7b);color:#00150f}
.form{display:grid;gap:10px}
.form label{font-size:12px;font-weight:800;color:#7fd7c0;text-transform:uppercase;letter-spacing:.5px}
.form input,.form select,.form textarea{width:100%;background:#0b202a;color:#fff;border:1px solid #29424d;border-radius:11px;padding:12px;font-size:14px;font-family:inherit;outline:none}
.form input:focus,.form select:focus,.form textarea:focus{border-color:var(--neon)}
.form textarea{min-height:70px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.save{background:linear-gradient(135deg,#00ef9f,#0ccf7b);color:#00150f;width:100%;padding:14px;font-size:15px}
.item{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:12px;border:1px solid var(--border);border-radius:13px;margin:8px 0;background:#0a1a22}
.item small{color:#9fb1b8;font-size:11px}
.actions{display:flex;gap:6px}
.edit{background:#2a1f5e;color:#c4b5fd;padding:8px 12px;font-size:12px}
.del{background:#4a1f1f;color:#fca5a5;padding:8px 12px;font-size:12px}
.share{background:#0c4a6e;color:#7dd3fc;padding:8px 12px;font-size:12px}
.thumbGrid{display:grid;grid-template-columns:repeat(5,1fr);gap:6px;margin-top:6px}
.thumbGrid img{width:100%;height:60px;object-fit:cover;border-radius:8px;border:1px solid var(--border)}
.shareBox{background:#0a2320;border:1px solid #20d9ba;border-radius:13px;padding:14px;margin-top:12px;font-size:13px}
.shareBox input{width:100%;background:#06141d;color:#b8fff0;border:1px solid #29424d;border-radius:9px;padding:10px;font-size:12px;margin-top:8px;font-family:monospace}
.badgePill{display:inline-block;background:#102d1d;color:#a8ffb8;font-size:10px;font-weight:900;padding:3px 8px;border-radius:20px;margin-right:4px}
.note{background:#0a2320;border:1px solid #20d9ba55;border-radius:12px;padding:12px;font-size:12px;color:#b8fff0;margin-bottom:12px}
.photoViewer{display:none;position:fixed;inset:0;background:#000e;z-index:100;align-items:center;justify-content:center;padding:18px}
.photoViewer.on{display:flex}
.viewerImg{max-width:94vw;max-height:88vh;object-fit:contain;border-radius:12px}
.viewerClose{position:absolute;top:14px;right:14px;background:#fff;color:#111;border-radius:50%;width:42px;height:42px;padding:0;font-size:20px}
.viewerArrow{position:absolute;top:50%;transform:translateY(-50%);background:#fff;color:#111;border-radius:50%;width:46px;height:46px;padding:0;font-size:28px}
.viewerPrev{left:16px}.viewerNext{right:16px}
@media(max-width:600px){.row{grid-template-columns:1fr}.photo{height:260px}.brand{font-size:22px}.headerApple{width:28px}.headerAndroid{width:32px}.hero h1{font-size:22px}}
</style>
</head>
<body>

<header>
  <div class="top">
    <div class="brandVisual">
      <svg class="headerApple" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
      <div>
        <div class="brand"><b>CHRIS</b> <span>CELL</span></div>
        <div class="sub">CELULARES E ACESSÓRIOS</div>
      </div>
      <svg class="headerAndroid" viewBox="0 0 24 24" fill="currentColor"><path d="M17.6 9.48l1.84-3.18c.16-.31.04-.69-.26-.85-.29-.15-.65-.06-.83.22l-1.88 3.24c-1.4-.6-2.96-.94-4.6-.94s-3.2.34-4.6.94L5.39 5.67c-.18-.28-.54-.37-.83-.22-.3.16-.42.54-.26.85L6.14 9.48C2.79 11.4.65 14.7.28 18.5h23.44c-.37-3.8-2.51-7.1-5.86-9.02h-.26zM7 15.25c-.69 0-1.25-.56-1.25-1.25s.56-1.25 1.25-1.25 1.25.56 1.25 1.25-.56 1.25-1.25 1.25zm10 0c-.69 0-1.25-.56-1.25-1.25s.56-1.25 1.25-1.25 1.25.56 1.25 1.25-.56 1.25-1.25 1.25z"/></svg>
    </div>
    <button class="adminBtn" onclick="openAdmin()">⚙️ Admin</button>
  </div>
</header>

<main>
  <div id="expiredView" class="expired" style="display:none">
    <h2>⏱️ Link Expirado</h2>
    <p>Este catálogo não está mais disponível. Fale com a Chris Cell pelo WhatsApp para receber um novo link.</p>
    <a id="expiredWa" href="#" target="_blank">💬 Falar no WhatsApp</a>
  </div>

  <div id="catalogView">
    <div class="hero">
      <h1>📱 Aparelhos disponíveis</h1>
      <div class="timer" id="timerBox" style="display:none">⏱️ Expira em <strong id="timerText">--:--:--</strong></div>
      <div class="heroPhrase" id="heroPhrase">Seu próximo celular começa aqui.</div>
      <p id="heroSub">Qualidade, confiança e preço justo.</p>
    </div>
    <div class="grid" id="grid"></div>
    <div class="empty" id="emptyMsg" style="display:none">Nenhum aparelho cadastrado ainda.</div>
  </div>
</main>

<!-- Painel Admin -->
<div class="overlay" id="adminOverlay">
  <div class="panel">
    <div class="panelHead">
      <h2>⚙️ Painel Chris Cell</h2>
      <button class="close" onclick="closeAdmin()">✕</button>
    </div>
    <div class="tabs">
      <button id="tabAdd" class="on" onclick="showTab('add')">➕ Adicionar</button>
      <button id="tabList" onclick="showTab('list')">📋 Aparelhos</button>
      <button id="tabShare" onclick="showTab('share')">🔗 Gerar link</button>
    </div>

    <!-- TAB ADD -->
    <div id="tabAddView">
      <div class="form">
        <label>Modelo</label>
        <input id="fModel" placeholder="Ex: iPhone 13">
        <div class="row">
          <div><label>Armazenamento</label><input id="fStorage" placeholder="Ex: 128GB"></div>
          <div><label>Cor</label><input id="fColor" placeholder="Ex: Preto"></div>
        </div>
        <div class="row">
          <div><label>Saúde da bateria</label><input id="fBattery" placeholder="Ex: 92%"></div>
          <div><label>Preço (R$)</label><input id="fPrice" placeholder="Ex: 2800"></div>
        </div>
        <div class="row">
          <div>
            <label>Sistema</label>
            <select id="fOS"><option value="android">🤖 Android</option><option value="apple">🍎 Apple (iOS)</option></select>
          </div>
          <div>
            <label>Status</label>
            <select id="fStatus"><option value="available">Disponível</option><option value="sold">Vendido</option></select>
          </div>
        </div>
        <label>Descrição / Observações</label>
        <textarea id="fDesc" placeholder="Ex: Sem marcas de uso, com carregador e película..."></textarea>
        <label>Fotos (até 10)</label>
        <input id="fPhotos" type="file" accept="image/*" multiple>
        <div class="thumbGrid" id="thumbPreview"></div>
        <button class="save" onclick="saveAparelho()">💾 Salvar aparelho</button>
      </div>
    </div>

    <!-- TAB LIST -->
    <div id="tabListView" style="display:none">
      <div class="note" id="countNote">0 aparelhos cadastrados</div>
      <div id="listItems"></div>
    </div>

    <!-- TAB SHARE -->
    <div id="tabShareView" style="display:none">
      <div class="note">Escolha o tempo e gere um link para enviar ao cliente.</div>
      <div class="form">
        <label>Tempo do link</label>
        <select id="shareTime">
          <option value="3">3 horas (padrão)</option>
          <option value="1">1 hora</option>
          <option value="6">6 horas</option>
          <option value="12">12 horas</option>
          <option value="24">24 horas</option>
        </select>
        <button class="save" onclick="gerarLink()">🔗 Gerar link</button>
      </div>
      <div class="shareBox" id="shareBox" style="display:none">
        <div>✅ Link gerado! Copie e envie no WhatsApp:</div>
        <input id="shareUrl" readonly onclick="this.select()">
        <button class="save" style="margin-top:10px" onclick="copiarLink()">📋 Copiar link</button>
      </div>
    </div>
  </div>
</div>

<!-- Viewer de foto -->
<div class="photoViewer" id="viewer">
  <button class="viewerClose" onclick="closeViewer()">✕</button>
  <button class="viewerArrow viewerPrev" onclick="viewerMove(-1)">‹</button>
  <img class="viewerImg" id="viewerImg">
  <button class="viewerArrow viewerNext" onclick="viewerMove(1)">›</button>
</div>

<script>
const WA = "5541998087911";
const STORAGE_KEY = "chriscell_aparelhos_v1";
let aparelhos = [];
let fotosTemp = [];
let editandoId = null;
let viewerList = [], viewerIndex = 0;

// ============== CARREGAR APARELHOS ==============
function loadAparelhos(){
  // tenta pegar da URL primeiro (link compartilhado)
  const params = new URLSearchParams(location.search);
  const dados = params.get("dados");
  if(dados){
    try{
      const decoded = JSON.parse(decodeURIComponent(escape(atob(dados))));
      aparelhos = decoded.aparelhos || [];
      renderTimer(decoded.exp);
      return;
    }catch(e){ console.warn("link inválido", e); }
  }
  // senão pega do localStorage (uso admin)
  try{ aparelhos = JSON.parse(localStorage.getItem(STORAGE_KEY) || "[]"); }catch(e){ aparelhos = []; }
  // se abriu #admin, mostra admin
  if(location.hash === "#admin"){ setTimeout(openAdmin, 100); }
  // sem timer em modo admin
  document.getElementById("timerBox").style.display = "none";
}

function saveAparelhosLocal(){
  try{ localStorage.setItem(STORAGE_KEY, JSON.stringify(aparelhos)); }catch(e){ alert("Erro ao salvar: " + e.message); }
}

// ============== RENDER CATÁLOGO ==============
function renderCatalogo(){
  const grid = document.getElementById("grid");
  grid.innerHTML = "";
  if(aparelhos.length === 0){
    document.getElementById("emptyMsg").style.display = "block";
    return;
  }
  document.getElementById("emptyMsg").style.display = "none";
  aparelhos.forEach(a => grid.appendChild(criarCard(a)));
}

function criarCard(a){
  const card = document.createElement("div");
  card.className = "card";
  const os = a.os === "apple" ? "apple" : "android";
  const osLabel = os === "apple" ? "🍎 Apple" : "🤖 Android";
  const status = a.status === "sold" ? '<div class="sold">● Vendido</div>' : '<div class="available">● Disponível</div>';
  const fotos = a.fotos && a.fotos.length ? a.fotos : [];
  const priceStr = a.price ? "R$ " + Number(a.price).toLocaleString("pt-BR") : "Consulte";

  let fotosHTML = "";
  if(fotos.length){
    fotosHTML = fotos.map((f,i) => `<div class="photoSlide"><img src="${f}" onclick="openViewer('${a.id}',${i})"></div>`).join("");
  } else {
    fotosHTML = `<div class="photoSlide"><div class="placeholder">📱</div></div>`;
  }

  card.innerHTML = `
    <div class="photo">
      <div class="photoTrack" id="track-${a.id}">${fotosHTML}</div>
      ${fotos.length>1?`<div class="photoNav"><button onclick="slide('${a.id}',-1)">‹</button><button onclick="slide('${a.id}',1)">›</button></div><div class="photoCountBadge">${fotos.length} fotos</div>`:""}
    </div>
    <div class="body">
      <div class="tag ${os}">${osLabel}</div>
      <h3>${a.model || "Sem nome"}</h3>
      <div class="meta">
        ${a.storage ? "💾 " + a.storage + "<br>" : ""}
        ${a.color ? "🎨 " + a.color + "<br>" : ""}
        ${a.battery ? "🔋 Bateria: " + a.battery + "<br>" : ""}
        ${a.desc ? "📝 " + a.desc : ""}
      </div>
      <div class="price">${priceStr}</div>
      ${status}
      <button class="interest" onclick="falarWhats('${(a.model||'').replace(/'/g,'')}')">💬 Falar no WhatsApp</button>
    </div>
  `;
  return card;
}

function slide(id, dir){
  const t = document.getElementById("track-"+id);
  if(!t) return;
  t.scrollBy({left: dir * t.clientWidth, behavior:"smooth"});
}

function falarWhats(modelo){
  const msg = encodeURIComponent(`Olá! Vi o catálogo da Chris Cell e tenho interesse no ${modelo}. Ainda está disponível?`);
  window.open(`https://wa.me/${WA}?text=${msg}`, "_blank");
}

// ============== VIEWER DE FOTO ==============
function openViewer(id, idx){
  const a = aparelhos.find(x => x.id === id);
  if(!a || !a.fotos || !a.fotos.length) return;
  viewerList = a.fotos;
  viewerIndex = idx;
  document.getElementById("viewerImg").src = viewerList[viewerIndex];
  document.getElementById("viewer").classList.add("on");
}
function closeViewer(){ document.getElementById("viewer").classList.remove("on"); }
function viewerMove(d){
  viewerIndex = (viewerIndex + d + viewerList.length) % viewerList.length;
  document.getElementById("viewerImg").src = viewerList[viewerIndex];
}

// ============== TIMER ==============
function renderTimer(expMs){
  const box = document.getElementById("timerBox");
  const txt = document.getElementById("timerText");
  if(!expMs){ box.style.display="none"; return; }
  box.style.display = "flex";
  const tick = () => {
    const rest = expMs - Date.now();
    if(rest <= 0){
      document.getElementById("catalogView").style.display = "none";
      document.getElementById("expiredView").style.display = "block";
      document.getElementById("expiredWa").href = `https://wa.me/${WA}?text=${encodeURIComponent("Olá! Meu link do catálogo expirou, pode me enviar outro?")}`;
      return;
    }
    const h = Math.floor(rest/3600000);
    const m = Math.floor((rest%3600000)/60000);
    const s = Math.floor((rest%60000)/1000);
    txt.textContent = String(h).padStart(2,"0")+":"+String(m).padStart(2,"0")+":"+String(s).padStart(2,"0");
  };
  tick();
  setInterval(tick, 1000);
}

// ============== ADMIN ==============
function openAdmin(){
  document.getElementById("adminOverlay").classList.add("on");
  renderLista();
  renderThumbs();
}
function closeAdmin(){ document.getElementById("adminOverlay").classList.remove("on"); }

function showTab(t){
  ["add","list","share"].forEach(x => {
    document.getElementById("tab"+x.charAt(0).toUpperCase()+x.slice(1)+"View").style.display = x===t?"block":"none";
    document.getElementById("tab"+x.charAt(0).toUpperCase()+x.slice(1)).classList.toggle("on", x===t);
  });
  if(t==="list") renderLista();
}

document.getElementById("fPhotos").addEventListener("change", e => {
  const files = Array.from(e.target.files).slice(0, 10 - fotosTemp.length);
  files.forEach(f => {
    const r = new FileReader();
    r.onload = ev => {
      // comprime a imagem
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement("canvas");
        const maxW = 800;
        const scale = Math.min(1, maxW/img.width);
        canvas.width = img.width*scale;
        canvas.height = img.height*scale;
        canvas.getContext("2d").drawImage(img,0,0,canvas.width,canvas.height);
        fotosTemp.push(canvas.toDataURL("image/jpeg",0.7));
        renderThumbs();
      };
      img.src = ev.target.result;
    };
    r.readAsDataURL(f);
  });
  e.target.value = "";
});

function renderThumbs(){
  document.getElementById("thumbPreview").in
