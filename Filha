<script>
const SUPABASE_URL="https://eovhszdqfwthxbghlbqg.supabase.co";
const SUPABASE_PUBLISHABLE_KEY="sb_publishable_8_TcKxlqD-70CCTvaLGkDg_CgVM9PCw";
const sb=window.supabase.createClient(SUPABASE_URL,SUPABASE_PUBLISHABLE_KEY);

const state={phones:[],currentUser:null,selectedPhotos:[],editingId:null,viewerId:null,viewerIndex:0,publicUrlExp:0};

function brandSVG(){return `
<svg class="brandMark" viewBox="0 0 24 24" aria-label="Apple">
  <path fill="currentColor" d="M16.7 12.7c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.7-1.7-3.3-1.7-1.4-.1-2.7.8-3.4.8-.7 0-1.8-.8-3-.8-1.5 0-2.9.9-3.7 2.2-1.6 2.7-.4 6.7 1.1 8.9.8 1.1 1.7 2.3 2.9 2.3 1.2-.1 1.6-.7 3-.7s1.8.7 3 .7c1.2 0 2-.1 2.8-1.2.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.6-1-2.6-4.4zM14.6 6.2c.6-.8 1-1.9.9-3-.9 0-2 .6-2.7 1.3-.6.7-1.1 1.8-1 2.9 1 .1 2-.5 2.8-1.2z"/>
</svg>`;}
function androidSVG(){return `
<svg class="androidMark" viewBox="0 0 64 64" aria-label="Android">
  <path fill="currentColor" d="M20 25h24v24H20z"/>
  <path fill="currentColor" d="M17 27h-4v17h4zm34 0h-4v17h4zM23 20l-3-5 2-1 3 5c4-2 10-2 14 0l3-5 2 1-3 5c3 2 5 5 5 9H18c0-4 2-7 5-9zm4-1a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0-4 0zM23 49h5v8h-5zm13 0h5v8h-5z"/>
</svg>`;}
function appleIcon(){return `<svg class="iconApple" viewBox="0 0 24 24"><path fill="currentColor" d="M16.7 12.7c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.7-1.7-3.3-1.7-1.4-.1-2.7.8-3.4.8-.7 0-1.8-.8-3-.8-1.5 0-2.9.9-3.7 2.2-1.6 2.7-.4 6.7 1.1 8.9.8 1.1 1.7 2.3 2.9 2.3 1.2-.1 1.6-.7 3-.7s1.8.7 3 .7c1.2 0 2-.1 2.8-1.2.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.6-1-2.6-4.4zM14.6 6.2c.6-.8 1-1.9.9-3-.9 0-2 .6-2.7 1.3-.6.7-1.1 1.8-1 2.9 1 .1 2-.5 2.8-1.2z"/></svg>`;}
function androidIcon(){return `<svg class="iconAndroid" viewBox="0 0 64 64"><path fill="currentColor" d="M20 25h24v24H20z"/><path fill="currentColor" d="M17 27h-4v17h4zm34 0h-4v17h4zM23 20l-3-5 2-1 3 5c4-2 10-2 14 0l3-5 2 1-3 5c3 2 5 5 5 9H18c0-4 2-7 5-9zm4-1a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0-4 0zM23 49h5v8h-5zm13 0h5v8h-5z"/></svg>`;}
function escapeHtml(str){return String(str ?? '').replace(/[&<>"']/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[ch]));}
function money(v){const n=Number(v||0); return n.toLocaleString('pt-BR',{style:'currency',currency:'BRL'});}
function categoryBadge(cat){return cat==='Android'?`<span class="tag">${androidIcon()} Android</span>`:`<span class="tag">${appleIcon()} Apple</span>`;}
function parseSpecs(value){try{return JSON.parse(value||'{}')}catch{return {}}}
function normalizePhotoUrl(value){
  if(!value)return '';
  const s=String(value).trim();
  if(!s)return '';
  if(s.startsWith('data:')||s.startsWith('blob:')||/^https?:\/\//i.test(s)) return s;
  const clean=s.replace(/^\/+/,'').replace(/^product-images\//,'');
  const publicUrl=sb.storage.from('product-images').getPublicUrl(clean).data.publicUrl;
  return publicUrl || '';
}
function normalizePhotos(row){
  let raw=row&&row.fotos;
  if(typeof raw === 'string'){ try{ raw=JSON.parse(raw); } catch{ raw=raw.split(',').map(x=>x.trim()).filter(Boolean); } }
  if(!Array.isArray(raw)) raw=[];
  return raw.map(normalizePhotoUrl).filter(Boolean).slice(0,10);
}
function renderLogin(){
  document.getElementById('app').innerHTML=`
    <header class="topbar"><div class="topbar-inner"><div class="brand">${brandSVG()}<div><div class="brandText">HRIS<span class="cell">CELL</span></div><div class="brandSub">CELULARES & ACESSÓRIOS</div></div></div>${androidSVG()}</div></header>
    <main class="main">
      <div class="gate">
        <div class="loginBox">
          <div class="loginBrand">${brandSVG()}<div class="brandText">HRIS<span class="cell">CELL</span></div>${androidSVG()}</div>
          <div class="loginTitle">Área exclusiva do administrador</div>
          <div class="loginForm">
            <label>E-mail</label>
            <input id="loginEmail" type="email" placeholder="seu@email.com">
            <label>Senha</label>
            <input id="loginPass" type="password" placeholder="Sua senha">
            <button class="loginBtn" type="button" onclick="doLogin()">ENTRAR</button>
            <div id="loginMsg" class="loginMsg"></div>
          </div>
        </div>
      </div>
    </main>`;
}
function parsePublicExp(){const exp=Number(new URLSearchParams(location.search).get('exp')||0); return Number.isFinite(exp)?exp:0;}
function updateExpiryBar(exp){
  const bar=document.getElementById('expiryBar');
  if(!bar) return;
  bar.style.display='inline-block';
  const tick=()=>{const left=exp-Date.now(); if(left<=0){bar.textContent='Link expirado'; setTimeout(()=>location.reload(),1200); return;} const total=Math.floor(left/1000); const h=Math.floor(total/3600),m=Math.floor((total%3600)/60),s=total%60; bar.textContent=`Catálogo expira em ${h}h ${String(m).padStart(2,'0')}m ${String(s).padStart(2,'0')}s`; setTimeout(tick,1000);}
  tick();
}
function renderCatalog(){
  const main=document.getElementById('app');
  main.innerHTML=`
    <header class="topbar"><div class="topbar-inner"><div class="brand">${brandSVG()}<div><div class="brandText">HRIS<span class="cell">CELL</span></div><div class="brandSub">CELULARES & ACESSÓRIOS</div></div></div>${androidSVG()}</div></header>
    <main class="main">
      <section class="catalogHero">
        <div class="heroRow">${brandSVG()}<div><div class="heroTitle">HRIS <span class="cell">CELL</span></div><div class="heroSub">CELULARES & ACESSÓRIOS</div></div>${androidSVG()}</div>
        <div class="trustRow"><span><b class="trustDot">✓</b> QUALIDADE</span><span><b class="trustDot">✓</b> CONFIANÇA</span><span><b class="trustDot">✓</b> PREÇO JUSTO</span></div>
        <div id="expiryBar" class="expiryBar"></div>
        <div class="controls">
          <input id="publicSearch" class="search" placeholder="Procurar modelo..." oninput="renderCatalogCards()">
          <select id="publicFilter" class="filter" onchange="renderCatalogCards()">
            <option value="all">Todos</option>
            <option value="Apple">Apple</option>
            <option value="Android">Android</option>
            <option value="available">Disponíveis</option>
          </select>
        </div>
      </section>
      <section id="catalogGrid" class="grid"></section>
    </main>`;
  const exp = parsePublicExp(); if(exp>0) updateExpiryBar(exp); renderCatalogCards();
}
function getCatalogList(){
  const q=(document.getElementById('publicSearch')?.value||'').toLowerCase();
  const filter=(document.getElementById('publicFilter')?.value||'all');
  let list=[...state.phones];
  if(q) list=list.filter(p=>`${p.model} ${p.storage} ${p.color} ${p.category}`.toLowerCase().includes(q));
  if(filter==='Apple') list=list.filter(p=>p.category==='Apple');
  if(filter==='Android') list=list.filter(p=>p.category==='Android');
  if(filter==='available') list=list.filter(p=>p.available!==false);
  return list;
}
function renderCatalogCards(){
  const grid=document.getElementById('catalogGrid');
  const list=getCatalogList();
  if(!list.length){grid.innerHTML='<div class="empty">Nenhum aparelho disponível no momento.</div>'; return;}
  grid.innerHTML=list.map(p=>{
    const photos=p.photos||[];
    const gallery=photos.length ? `
      <div class="track" id="track-${p.id}">
        ${photos.map((src,i)=>`
          <div class="slide" onclick="openViewer('${p.id}',${i})">
            <img src="${escapeHtml(src)}" alt="${escapeHtml(p.model)}">
          </div>`).join('')}
      </div>
      ${photos.length>1 ? `
        <div class="photoNav">
          <button type="button" onclick="event.stopPropagation(); moveTrack('${p.id}',-1)">‹</button>
          <button type="button" onclick="event.stopPropagation(); moveTrack('${p.id}',1)">›</button>
        </div>
        <div class="dots">${photos.map((_,i)=>`<span class="dot" id="dot-${p.id}-${i}" style="opacity:${i===0 ? 1 : .38}"></span>`).join('')}</div>
        <div class="countBadge">1/${photos.length}</div>
      ` : ''}`*
