<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Chris Cell — Catálogo</title>
<style>
:root{
  --bg:#040b09; --panel:#0b1715; --panel2:#0d201c; --text:#f2fff9; --muted:#a7c0b6; --green:#18f7a3; --green2:#00c877; --line:#244a40; --danger:#ff5364;
}
*{box-sizing:border-box}
html,body{margin:0;min-height:100%;font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;background:radial-gradient(circle at 50% -10%,rgba(22,101,72,.4),transparent 25%),linear-gradient(180deg,#020806,#061410 38%,#020907 100%);color:var(--text)}
button,input,select,textarea{font:inherit}
button{border:0;cursor:pointer}
.hidden{display:none!important}
.topbar{background:linear-gradient(180deg,#071511,#05120f);border-bottom:1px solid var(--line);padding:18px 18px 14px;position:relative;overflow:hidden}
.topbar:after{content:"";position:absolute;inset:auto -10% -80px 10%;height:140px;background:radial-gradient(ellipse,rgba(24,247,163,.18),transparent 70%);pointer-events:none}
.topbar-inner{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:12px;position:relative;z-index:1}
.brand{display:flex;align-items:center;gap:12px}
.brandMark,.androidMark{width:42px;height:42px;display:inline-block}
.brandMark{color:#fff}.androidMark{color:#5ae757}
.brandText{font-weight:950;line-height:0.9;letter-spacing:.5px;font-size:24px}
.brandText .cell{display:block;color:var(--green);font-size:22px;margin-top:3px}
.brandSub{font-size:9px;letter-spacing:3px;color:#9ab6ad;margin-top:7px}
.main{max-width:1180px;margin:0 auto;padding:20px 16px 60px}
.gate{min-height:calc(100vh - 95px);display:flex;align-items:center;justify-content:center;padding:20px}
.loginBox{width:min(420px,100%);background:linear-gradient(145deg,#0d1c1a,#07110f);border:1px solid var(--line);border-radius:22px;padding:28px 22px 20px;box-shadow:0 28px 90px rgba(0,0,0,.55);text-align:center}
.loginBrand{display:flex;justify-content:center;align-items:center;gap:12px;margin-bottom:18px}
.loginTitle{font-size:13px;color:#9ab6ad;letter-spacing:2px;text-transform:uppercase;margin:4px 0 18px}
.loginForm{display:grid;gap:10px;text-align:left}
.loginForm label{font-size:11px;color:#d6eae4;font-weight:800;letter-spacing:.6px;text-transform:uppercase}
.loginForm input{background:#071512;border:1px solid var(--line);border-radius:12px;color:var(--text);padding:12px 13px;outline:none}
.loginBtn{margin-top:6px;padding:12px 16px;border-radius:12px;background:linear-gradient(180deg,#18f7a3,#00c877);color:#04170f;font-weight:950;letter-spacing:.8px}
.loginMsg{min-height:18px;color:var(--danger);font-size:12px;text-align:center;margin-top:4px}
.catalogHero{background:linear-gradient(145deg,#0d1d1a,#081512);border:1px solid var(--line);border-radius:22px;padding:18px;position:relative;overflow:hidden}
.catalogHero:before{content:"";position:absolute;width:260px;height:260px;right:-110px;top:-150px;background:rgba(24,247,163,.12);filter:blur(38px);border-radius:50%;pointer-events:none}
.heroRow{display:flex;align-items:center;gap:10px;position:relative;z-index:1}
.heroTitle{font-size:24px;font-weight:950;line-height:1}
.heroTitle .cell{color:var(--green)}
.heroSub{font-size:9px;letter-spacing:3px;color:#9ab6ad;margin-top:5px}
.trustRow{display:flex;flex-wrap:wrap;gap:22px;position:relative;z-index:1;color:#dfeae7;font-size:11px;font-weight:800;margin-top:16px}
.trustRow span{display:flex;align-items:center;gap:7px}
.trustDot{color:var(--green);font-size:16px;font-weight:900}
.expiryBar{display:none;margin-top:14px;background:#10372b;border:1px solid #1f7055;color:#9ef7c7;border-radius:10px;padding:9px 12px;font-size:12px;font-weight:900;position:relative;z-index:1}
.controls{margin-top:16px;display:flex;flex-wrap:wrap;gap:10px;position:relative;z-index:1}
.search{flex:1;min-width:220px;background:#071512;border:1px solid var(--line);color:var(--text);border-radius:12px;padding:12px 13px;outline:none}
.search::placeholder{color:#7a9189}
.filter{background:#081512;border:1px solid var(--line);color:var(--text);border-radius:12px;padding:12px 13px;min-width:170px;outline:none}
.grid{margin-top:18px;display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:16px}
.card{background:linear-gradient(180deg,#0b1916,#08120f);border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:0 12px 32px rgba(0,0,0,.24)}
.photo{position:relative;height:290px;background:#07100d;overflow:hidden;border-bottom:1px solid rgba(255,255,255,.02)}
.track{display:flex;width:100%;height:100%;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none}
.track::-webkit-scrollbar{display:none}
.slide{min-width:100%;height:100%;scroll-snap-align:center;display:flex;align-items:center;justify-content:center;background:#0a1412}
.slide img{width:100%;height:100%;object-fit:contain;display:block}
.placeholder{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#335048;font-size:56px;background:linear-gradient(180deg,#0d1715,#091210)}
.photoNav{position:absolute;inset:50% 8px auto 8px;transform:translateY(-50%);display:flex;justify-content:space-between;pointer-events:none}
.photoNav button{pointer-events:auto;width:34px;height:34px;border-radius:50%;background:rgba(0,0,0,.72);color:#fff;font-size:24px;line-height:1}
.dots{position:absolute;left:0;right:0;bottom:9px;display:flex;justify-content:center;gap:6px}
.dot{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.4)}
.countBadge{position:absolute;top:10px;right:10px;background:rgba(0,0,0,.72);color:#fff;border-radius:16px;padding:5px 9px;font-size:11px;font-weight:900}
.cardBody{padding:14px 13px 12px}
.tag{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:18px;border:1px solid #245b46;background:#0c251d;color:#9ef7c7;font-size:11px;font-weight:900}
.cardBody h3{margin:10px 0 4px;font-size:17px;line-height:1.2}
.meta{color:#9bb2aa;font-size:12px;line-height:1.5}
.price{margin:10px 0 6px;font-size:20px;font-weight:950}
.state{font-size:11px;font-weight:900;letter-spacing:.1px}
.state.available{color:#5af7b3}
.state.sold{color:#ff7a8d}
.interest{width:100%;margin-top:10px;padding:11px 12px;border-radius:12px;background:linear-gradient(180deg,#18f7a3,#00c877);color:#00190f;font-weight:950;letter-spacing:.3px}
.empty{width:100%;text-align:center;color:#90a7a1;padding:54px 18px;font-size:15px;line-height:1.7}
.adminPanel{display:none;position:fixed;inset:0;background:rgba(0,0,0,.78);z-index:30;overflow:auto;padding:22px 16px}
.adminPanel.open{display:block}
.panel{max-width:760px;margin:20px auto;background:linear-gradient(180deg,#0b1715,#091311);border:1px solid var(--line);border-radius:22px;padding:18px 18px 16px;box-shadow:0 30px 80px rgba(0,0,0,.5)}
.panelHead{display:flex;justify-content:space-between;align-items:center;gap:10px}
.panelHead h2{margin:0;font-size:22px}
.closeBtn{background:#18342d;border:1px solid var(--line);color:#fff;border-radius:10px;padding:8px 12px;font-weight:800}
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin:16px 0 14px}
.tab{background:#132923;border:1px solid var(--line);color:#d7ece5;border-radius:10px;padding:9px 12px;font-weight:800}
.tab.active{background:#00df7d;color:#00170e;border-color:#00df7d}
.tab.share{background:#103d30;color:#89ffbf;border-color:#1a5d49}
.board{display:block}
.notice{background:#0e2a20;border:1px solid #1d6148;color:#9ef7c7;border-radius:10px;padding:10px 12px;font-size:12px;line-height:1.5}
.form{display:grid;gap:10px;margin-top:12px}
.form label{font-size:11px;color:#dfeae7;font-weight:800;letter-spacing:.6px;text-transform:uppercase}
.form input,.form select,.form textarea{width:100%;background:#071512;border:1px solid var(--line);color:var(--text);border-radius:10px;padding:11px 12px;outline:none}
.form textarea{min-height:80px;resize:vertical}
.row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.note{font-size:11px;color:#a4b9b1;line-height:1.5}
.thumbs{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:2px}
.thumbBox{position:relative;overflow:hidden;border-radius:8px;border:1px solid var(--line);background:#0b1715;height:62px}
.thumbBox img{width:100%;height:100%;object-fit:cover;display:block}
.removeThumb{position:absolute;right:4px;top:4px;width:18px;height:18px;border-radius:50%;background:rgba(255,82,100,.95);color:#fff;font-size:14px;display:flex;align-items:center;justify-content:center;line-height:1;padding:0}
.saveBtn{width:100%;padding:12px 14px;border-radius:12px;background:linear-gradient(180deg,#18f7a3,#00c877);color:#00170e;font-weight:950;letter-spacing:.7px}
.stockList{display:grid;gap:10px}
.stockItem{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;padding:12px;border:1px solid var(--line);background:#091412;border-radius:12px}
.stockInfo{min-width:0;flex:1}
.stockInfo strong{display:block;margin-bottom:6px;font-size:14px}
.stockInfo small{display:block;color:#98b1a9;line-height:1.6}
.stockPhotos{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.stockPhotos img{width:52px;height:52px;object-fit:cover;border-radius:7px;border:1px solid #31564b;cursor:pointer;background:#0a1512}
.stockActions{display:flex;gap:6px;flex-wrap:wrap;justify-content:flex-end;min-width:140px}
.btn{padding:9px 10px;border-radius:10px;color:#fff;font-weight:800;font-size:12px}
.btn.primary{background:#173d32;color:#9ef7c7}
.btn.edit{background:#213c34;color:#b4f8d7}
.btn.delete{background:#3f1b25;color:#ffb0bf}
.viewer{display:none;position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:80;padding:28px;align-items:center;justify-content:center}
.viewer.open{display:flex}
.viewerBox{position:relative;max-width:94vw;max-height:88vh;display:flex;align-items:center;justify-content:center}
.viewerBox img{max-width:94vw;max-height:88vh;object-fit:contain;border-radius:12px;box-shadow:0 18px 60px rgba(0,0,0,.52)}
.viewerClose,.viewerArrow{position:absolute;width:42px;height:42px;border-radius:50%;background:#fff;color:#111;font-size:28px;display:flex;align-items:center;justify-content:center;line-height:1;font-weight:900;user-select:none}
.viewerClose{top:16px;right:16px;z-index:2}
.viewerArrow{top:50%;transform:translateY(-50%);z-index:2}
.viewerArrow.prev{left:16px}.viewerArrow.next{right:16px}
.viewerTitle{position:absolute;top:18px;left:18px;background:rgba(0,0,0,.35);color:#fff;border-radius:12px;padding:7px 12px;font-weight:800;font-size:13px}
.viewerIndex{position:absolute;top:18px;left:50%;transform:translateX(-50%);background:rgba(0,0,0,.4);color:#fff;border-radius:18px;padding:7px 12px;font-size:12px;font-weight:800}
.iconApple,.iconAndroid{width:18px;height:18px;display:inline-block;vertical-align:middle}
@media (max-width:600px){.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.photo{height:240px}.row{grid-template-columns:1fr}.stockItem{flex-direction:column}.stockActions{width:100%;justify-content:flex-start}}
</style>
</head>
