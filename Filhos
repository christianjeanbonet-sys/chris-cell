<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Chris Cell — Catálogo</title>
  <style>
    :root{
      --bg:#040b0a;
      --bg2:#071914;
      --panel:#0b1715;
      --panel-2:#0f201d;
      --card:#0d1917;
      --line:#214b40;
      --text:#eefef8;
      --muted:#a7c0b7;
      --green:#18f7a3;
      --green2:#00c877;
      --green3:#7ef7bf;
      --danger:#ff5364;
      --warning:#ffca4d;
      --shadow:rgba(0,0,0,.42);
      --white:#ffffff;
    }

    *{box-sizing:border-box}
    html,body{
      margin:0;
      min-height:100%;
      font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;
      background:radial-gradient(circle at 50% -10%, rgba(20,116,85,.4), transparent 28%),
                 linear-gradient(180deg,#020806,#061410 35%,#020907 100%);
      color:var(--text);
    }

    body{
      min-height:100vh;
    }

    button,input,select,textarea{
      font:inherit;
    }

    button{
      border:0;
      cursor:pointer;
      transition:.2s ease;
    }

    a{
      text-decoration:none;
    }

    .hidden{ display:none !important; }

    .app-shell{
      min-height:100vh;
      padding:0;
    }

    .topbar{
      position:relative;
      background:linear-gradient(180deg,#071511 0%, #05120f 100%);
      border-bottom:1px solid var(--line);
      box-shadow:0 12px 28px rgba(0,0,0,.18);
      padding:18px 18px 14px;
      overflow:hidden;
    }

    .topbar:after{
      content:"";
      position:absolute;
      inset:auto -5% -80px 10%;
      height:140px;
      background:radial-gradient(ellipse, rgba(24,247,163,.18), transparent 68%);
      pointer-events:none;
    }

    .topbar-inner{
      max-width:1180px;
      margin:0 auto;
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:12px;
      position:relative;
      z-index:1;
    }

    .brand{
      display:flex;
      align-items:center;
      gap:12px;
    }

    .brand-mark, .android-mark{
      width:42px;
      height:42px;
      display:inline-block;
      vertical-align:middle;
    }

    .brand-mark{ color:#fff; }
    .android-mark{ color:#5ae757; }

    .brand-text{
      font-weight:950;
      line-height:0.9;
      letter-spacing:0.5px;
      font-size:24px;
    }

    .brand-text .cell{
      display:block;
      color:var(--green);
      font-size:22px;
      margin-top:3px;
    }

    .brand-sub{
      font-size:9px;
      letter-spacing:3px;
      color:#9ab6ad;
      margin-top:7px;
    }

    .main{
      max-width:1180px;
      margin:0 auto;
      padding:20px 16px 60px;
    }

    .admin-login-wrap{
      min-height:calc(100vh - 90px);
      display:flex;
      align-items:center;
      justify-content:center;
      padding:28px 16px;
    }

    .admin-login{
      width:min(430px,100%);
      background:linear-gradient(145deg,#0d1c1a,#07110f);
      border:1px solid var(--line);
      border-radius:22px;
      padding:28px 22px 20px;
      box-shadow:0 28px 90px rgba(0,0,0,.55);
      text-align:center;
    }

    .login-brand{
      display:flex;
      justify-content:center;
      align-items:center;
      gap:12px;
      margin-bottom:18px;
    }

    .login-brand .brand-text{
      font-size:22px;
    }

    .login-title{
      font-size:13px;
      color:#9ab6ad;
      letter-spacing:2px;
      text-transform:uppercase;
      margin:4px 0 18px;
    }

    .login-form{
      display:grid;
      gap:10px;
      text-align:left;
    }

    .login-form label{
      font-size:11px;
      color:#d6eae4;
      font-weight:800;
      letter-spacing:.6px;
      text-transform:uppercase;
    }

    .login-form input{
      background:#071512;
      border:1px solid var(--line);
      border-radius:12px;
      color:var(--text);
      padding:12px 13px;
      outline:none;
    }

    .login-btn{
      margin-top:6px;
      padding:12px 16px;
      border-radius:12px;
      background:linear-gradient(180deg,#18f7a3,#00c877);
      color:#04170f;
      font-weight:950;
      letter-spacing:.8px;
    }

    .login-msg{
      min-height:18px;
      color:var(--danger);
      font-size:12px;
      text-align:center;
      margin-top:4px;
    }

    .login-cancel{
      background:transparent;
      color:#9ab6ad;
      padding:8px 10px;
      border-radius:10px;
      border:1px solid transparent;
      margin-top:4px;
    }

    .catalog-shell{
      display:block;
    }

    .catalog-hero{
      background:linear-gradient(145deg,#0d1d1a,#081512);
      border:1px solid var(--line);
      border-radius:22px;
      padding:18px;
      position:relative;
      overflow:hidden;
      box-shadow:0 20px 50px rgba(0,0,0,.28);
    }

    .catalog-hero:before{
      content:"";
      position:absolute;
      width:260px;
      height:260px;
      right:-110px;
      top:-150px;
      background:rgba(24,247,163,.12);
      filter:blur(38px);
      border-radius:50%;
      pointer-events:none;
    }

    .hero-row{
      display:flex;
      align-items:center;
      gap:10px;
      position:relative;
      z-index:1;
    }

    .hero-title{
      font-size:24px;
      font-weight:950;
      line-height:1;
    }

    .hero-title .cell{
      color:var(--green);
    }

    .hero-sub{
      font-size:9px;
      letter-spacing:3px;
      color:#9ab6ad;
      margin-top:5px;
    }

    .hero-trust{
      margin-top:16px;
      display:flex;
      flex-wrap:wrap;
      gap:22px;
      position:relative;
      z-index:1;
      color:#dfeae7;
      font-size:11px;
      font-weight:800;
    }

    .hero-trust span{
      display:flex;
      align-items:center;
      gap:7px;
    }

    .trust-dot{
      color:var(--green);
      font-size:16px;
      font-weight:900;
    }

    .expiry-bar{
      margin-top:14px;
      display:inline-block;
      background:#10372b;
      border:1px solid #1f7055;
      color:#9ef7c7;
      border-radius:10px;
      padding:9px 12px;
      font-size:12px;
      font-weight:900;
      position:relative;
      z-index:1;
    }

    .controls{
      margin-top:16px;
      display:flex;
      flex-wrap:wrap;
      gap:10px;
      position:relative;
      z-index:1;
    }

    .search{
      flex:1;
      min-width:220px;
      background:#071512;
      border:1px solid var(--line);
      color:var(--text);
      border-radius:12px;
      padding:12px 13px;
      outline:none;
    }

    .search::placeholder{
      color:#7a9189;
    }

    .filter{
      background:#081512;
      border:1px solid var(--line);
      color:var(--text);
      border-radius:12px;
      padding:12px 13px;
      min-width:170px;
      outline:none;
    }

    .catalog-grid{
      margin-top:18px;
      display:grid;
      grid-template-columns:repeat(auto-fill,minmax(240px,1fr));
      gap:16px;
    }

    .product-card{
      background:linear-gradient(180deg,#0b1916,#08120f);
      border:1px solid var(--line);
      border-radius:18px;
      overflow:hidden;
      box-shadow:0 12px 32px rgba(0,0,0,.24);
    }

    .product-image{
      position:relative;
      height:290px;
      background:#07100d;
      overflow:hidden;
      border-bottom:1px solid rgba(255,255,255,.02);
    }

    .product-track{
      display:flex;
      width:100%;
      height:100%;
      overflow-x:auto;
      scroll-snap-type:x mandatory;
      scrollbar-width:none;
    }

    .product-track::-webkit-scrollbar{
      display:none;
    }

    .product-slide{
      min-width:100%;
      height:100%;
      scroll-snap-align:center;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#0a1412;
      position:relative;
    }

    .product-slide img{
      width:100%;
      height:100%;
      object-fit:contain;
      display:block;
      border:0;
    }

    .product-placeholder{
      width:100%;
      height:100%;
      display:flex;
      align-items:center;
      justify-content:center;
      color:#335048;
      font-size:56px;
      background:linear-gradient(180deg,#0d1715,#091210);
    }

    .product-nav{
      position:absolute;
      inset:50% 8px auto 8px;
      transform:translateY(-50%);
      display:flex;
      justify-content:space-between;
      pointer-events:none;
    }

    .product-nav button{
      pointer-events:auto;
      width:34px;
      height:34px;
      border-radius:50%;
      background:rgba(0,0,0,.72);
      color:#fff;
      font-size:24px;
      line-height:1;
    }

    .product-dots{
      position:absolute;
      left:0;
      right:0;
      bottom:9px;
      display:flex;
      justify-content:center;
      gap:6px;
    }

    .product-dot{
      width:7px;
      height:7px;
      border-radius:50%;
      background:rgba(255,255,255,.4);
    }

    .product-count{
      position:absolute;
      top:10px;
      right:10px;
      background:rgba(0,0,0,.72);
      color:#fff;
      border-radius:16px;
      padding:5px 9px;
      font-size:11px;
      font-weight:900;
    }

    .product-body{
      padding:14px 13px 12px;
    }

    .tag{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:5px 9px;
      border-radius:18px;
      border:1px solid #245b46;
      background:#0c251d;
      color:#9ef7c7;
      font-size:11px;
      font-weight:900;
    }

    .product-body h3{
      margin:10px 0 4px;
      font-size:17px;
      line-height:1.2;
    }

    .meta{
      color:#9bb2aa;
      font-size:12px;
      line-height:1.5;
    }

    .price{
      margin:10px 0 6px;
      font-size:20px;
      font-weight:950;
    }

    .state{
      font-size:11px;
      font-weight:900;
      letter-spacing:.1px;
    }

    .state.available{ color:#5af7b3; }
    .state.sold{ color:#ff7a8d; }

    .interest{
      width:100%;
      margin-top:10px;
      padding:11px 12px;
      border-radius:12px;
      background:linear-gradient(180deg,#18f7a3,#00c877);
      color:#00190f;
      font-weight:950;
      letter-spacing:.3px;
    }

    .empty{
      width:100%;
      text-align:center;
      color:#90a7a1;
      padding:54px 18px;
      font-size:15px;
      line-height:1.7;
    }

    .admin-panel{
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,.78);
      z-index:30;
      overflow:auto;
      padding:22px 16px;
    }

    .admin-panel.open{
      display:block;
    }

    .panel{
      max-width:760px;
      margin:20px auto;
      background:linear-gradient(180deg,#0b1715,#091311);
      border:1px solid var(--line);
      border-radius:22px;
      padding:18px 18px 16px;
      box-shadow:0 30px 80px rgba(0,0,0,.5);
    }

    .panel-head{
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:10px;
    }

    .panel-head h2{
      margin:0;
      font-size:22px;
    }

    .close-btn{
      background:#18342d;
      border:1px solid var(--line);
      color:#fff;
      border-radius:10px;
      padding:8px 12px;
      font-weight:800;
    }

    .tabs{
      display:flex;
      flex-wrap:wrap;
      gap:8px;
      margin:16px 0 14px;
    }

    .tab-btn{
      background:#132923;
      border:1px solid var(--line);
      color:#d7ece5;
      border-radius:10px;
      padding:9px 12px;
      font-weight:800;
    }

    .tab-btn.active{
      background:#00df7d;
      color:#00170e;
      border-color:#00df7d;
    }

    .tab-btn.share{
      background:#103d30;
      color:#89ffbf;
      border-color:#1a5d49;
    }

    .board{
      display:block;
    }

    .info-note{
      background:#0e2a20;
      border:1px solid #1d6148;
      color:#9ef7c7;
      border-radius:10px;
      padding:10px 12px;
      font-size:12px;
      line-height:1.5;
    }

    .form{
      display:grid;
      gap:10px;
      margin-top:12px;
    }

    .form label{
      font-size:11px;
      color:#dfeae7;
      font-weight:800;
      letter-spacing:.6px;
      text-transform:uppercase;
    }

    .form input,
    .form select,
    .form textarea{
      width:100%;
      background:#071512;
      border:1px solid var(--line);
      color:var(--text);
      border-radius:10px;
      padding:11px 12px;
      outline:none;
    }

    .form textarea{
      min-height:80px;
      resize:vertical;
    }

    .row{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:10px;
    }

    .small-note{
      font-size:11px;
      color:#a4b9b1;
      line-height:1.5;
    }

    .thumbs{
      display:grid;
      grid-template-columns:repeat(5, minmax(0,1fr));
      gap:8px;
      margin-top:2px;
    }

    .thumb-box{
      position:relative;
      overflow:hidden;
      border-radius:8px;
      border:1px solid var(--line);
      background:#0b1715;
      height:62px;
    }

    .thumb-box img{
      width:100%;
      height:100%;
      object-fit:cover;
      display:block;
    }

    .remove-thumb{
      position:absolute;
      right:4px;
      top:4px;
      width:18px;
      height:18px;
      border-radius:50%;
      background:rgba(255,82,100,.95);
      color:#fff;
      font-size:14px;
      display:flex;
      align-items:center;
      justify-content:center;
      line-height:1;
      padding:0;
    }

    .save-btn{
      width:100%;
      padding:12px 14px;
      border-radius:12px;
      background:linear-gradient(180deg,#18f7a3,#00c877);
      color:#00170e;
      font-weight:950;
      letter-spacing:.7px;
    }

    .stock-list{
      display:grid;
      gap:10px;
    }

    .stock-item{
      display:flex;
      justify-content:space-between;
      gap:12px;
      align-items:flex-start;
      padding:12px;
      border:1px solid var(--line);
      background:#091412;
      border-radius:12px;
    }

    .stock-info{
      min-width:0;
      flex:1;
    }

    .stock-info strong{
      display:block;
      margin-bottom:6px;
      font-size:14px;
    }

    .stock-info small{
      display:block;
      color:#98b1a9;
      line-height:1.6;
    }

    .stock-photos{
      display:flex;
      flex-wrap:wrap;
      gap:6px;
      margin-top:8px;
    }

    .stock-photos img{
      width:52px;
      height:52px;
      object-fit:cover;
      border-radius:7px;
      border:1px solid #31564b;
      cursor:pointer;
      background:#0a1512;
    }

    .stock-actions{
      display:flex;
      gap:6px;
      flex-wrap:wrap;
      justify-content:flex-end;
      min-width:120px;
    }

    .btn{
      padding:9px 10px;
      border-radius:10px;
      color:#fff;
      font-weight:800;
      font-size:12px;
    }

    .btn.primary{ background:#173d32; color:#9ef7c7; }
    .btn.edit{ background:#213c34; color:#b4f8d7; }
    .btn.delete{ background:#3f1b25; color:#ffb0bf; }

    .viewer{
      display:none;
      position:fixed;
      inset:0;
      background:rgba(0,0,0,.9);
      z-index:80;
      padding:28px;
      align-items:center;
      justify-content:center;
    }

    .viewer.open{
      display:flex;
    }

    .viewer-box{
      position:relative;
      max-width:94vw;
      max-height:88vh;
      display:flex;
      align-items:center;
      justify-content:center;
    }

    .viewer-box img{
      max-width:94vw;
      max-height:88vh;
      object-fit:contain;
      border-radius:12px;
      box-shadow:0 18px 60px rgba(0,0,0,.52);
    }

    .viewer-close,
    .viewer-arrow{
      position:absolute;
      width:42px;
      height:42px;
      border-radius:50%;
      background:#fff;
      color:#111;
      font-size:28px;
      display:flex;
      align-items:center;
      justify-content:center;
      line-height:1;
      font-weight:900;
      user-select:none;
    }

    .viewer-close{
      top:16px;
      right:16px;
      z-index:2;
    }

    .viewer-arrow{
      top:50%;
      transform:translateY(-50%);
      z-index:2;
    }

    .viewer-arrow.prev{ left:16px; }
    .viewer-arrow.next{ right:16px; }

    .viewer-title{
      position:absolute;
      top:18px;
      left:18px;
      background:rgba(0,0,0,.35);
      color:#fff;
      border-radius:12px;
      padding:7px 12px;
      font-weight:800;
      font-size:13px;
    }

    .viewer-index{
      position:absolute;
      top:18px;
      left:50%;
      transform:translateX(-50%);
      background:rgba(0,0,0,.4);
      color:#fff;
      border-radius:18px;
      padding:7px 12px;
      font-size:12px;
      font-weight:800;
    }

    .icon-apple, .icon-android{
      width:18px;
      height:18px;
      display:inline-block;
      vertical-align:middle;
    }

    @media (max-width:600px){
      .catalog-grid{
        grid-template-columns:repeat(2, minmax(0,1fr));
        gap:10px;
      }

      .product-image{
        height:240px;
      }

      .row{
        grid-template-columns:1fr;
      }

      .stock-item{
        flex-direction:column;
      }

      .stock-actions{
        width:100%;
        justify-content:flex-start;
      }
    }
  </style>
</head>
<body>
  <div id="app"></div>

  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  <script>
    const SUPABASE_URL = "https://eovhszdqfwthxbghlbqg.supabase.co";
    const SUPABASE_PUBLISHABLE_KEY = "sb_publishable_8_TcKxlqD-70CCTvaLGkDg_CgVM9PCw";
    const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY);

    const state = {
      phones: [],
      currentUser: null,
      editingId: null,
      selectedPhotos: [],
      galleryPhotos: [],
      viewerId: null,
      viewerIndex: 0,
      publicCatalogExpiresAt: 0,
      publicMode: false
    };

    function appMarkup(){
      return `
        <div class="app-shell">
          <header class="topbar">
            <div class="topbar-inner">
              <div class="brand">
                ${brandSVG()}
                <div>
                  <div class="brand-text">HRIS<span class="cell">CELL</span></div>
                  <div class="brand-sub">CELULARES & ACESSÓRIOS</div>
                </div>
              </div>
              <div class="brand">
                ${androidSVG()}
              </div>
            </div>
          </header>

          <main class="main" id="main"></main>
        </div>

        <div id="adminPanel" class="admin-panel" aria-hidden="true"></div>

        <div id="photoViewer" class="viewer" onclick="if(event.target===this) closeViewer();">
          <div class="viewer-box">
            <div class="viewer-title" id="viewerTitle"></div>
            <div class="viewer-index" id="viewerIndex"></div>
            <button class="viewer-close" type="button" onclick="event.stopPropagation(); closeViewer();">✕</button>
            <button class="viewer-arrow prev" type="button" onclick="event.stopPropagation(); changeViewer(-1);">‹</button>
            <img id="viewerImg" alt="Foto do aparelho">
            <button class="viewer-arrow next" type="button" onclick="event.stopPropagation(); changeViewer(1);">›</button>
          </div>
        </div>
      `;
    }

    function brandSVG(){
      return `
        <svg class="brand-mark" viewBox="0 0 24 24" aria-label="Apple">
          <path fill="currentColor" d="M16.7 12.7c0-2.2 1.8-3.3 1.9-3.4-1-1.5-2.7-1.7-3.3-1.7-1.4-.1-2.7.8-3.4.8-.7 0-1.8-.8-3-.8-1.5 0-2.9.9-3.7 2.2-1.6 2.7-.4 6.7 1.1 8.9.8 1.1 1.7 2.3 2.9 2.3 1.2-.1 1.6-.7 3-.7s1.8.7 3 .7c1.2 0 2-.1 2.8-1.2.9-1.3 1.3-2.6 1.3-2.7-.1 0-2.6-1-2.6-4.4zM14.6 6.2c.6-.8 1-1.9.9-3-.9 0-2 .6-2.7 1.3-.6.7-1.1 1.8-1 2.9 1 .1 2-.5 2.8-1.2z"/>
        </svg>
      `;
    }

    function androidSVG(){
      return `
